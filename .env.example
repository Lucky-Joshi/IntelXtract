# IntelXtract environment configuration.
#
# Copy this file to `.env` (git-ignored) and fill in your own values:
#
#     cp .env.example .env
#
# IntelXtract loads `.env` on startup; values never override environment
# variables that are already set, so exporting a variable wins over this file.
#
# Values map to config keys. Nested keys use `__` (double underscore) as the
# separator and names are lower-cased, so:
#
#     INTELXTRACT_API_KEYS__HIBP  ->  config api_keys.hibp
#
# Every key below is optional: a module or plugin that needs a missing key is
# skipped (or falls back to a key-free path) instead of failing the scan.

# --- External API keys (used by bundled modules/plugins) ---------------------

# HIBP — email breach exposure (modules/email/breach.py). Required to run the
# breach module; without it that module is skipped.
# Get a key: https://haveibeenpwned.com/API/Key
INTELXTRACT_API_KEYS__HIBP=

# AbuseIPDB — optional IP reputation enrichment (modules/ip/reputation.py).
# Reputation still works via key-free Spamhaus ZEN and DNSBL when unset.
# Get a key: https://www.abuseipdb.com/api
INTELXTRACT_API_KEYS__ABUSEIPDB=

# VirusTotal — domain report plugin (plugins/VirusTotal). Required to run that
# plugin; without it the plugin is skipped.
# Get a key: https://docs.virustotal.com/reference/overview
INTELXTRACT_API_KEYS__VIRUSTOTAL=

# --- Reserved providers (listed in the GUI API Manager) ----------------------
# No bundled module consumes these yet; uncomment and fill in when a plugin or
# future module needs them.
#INTELXTRACT_API_KEYS__SHODAN=
#INTELXTRACT_API_KEYS__CENSYS=
#INTELXTRACT_API_KEYS__SECURITYTRAILS=
#INTELXTRACT_API_KEYS__EMAILREP=
#INTELXTRACT_API_KEYS__HUNTER=
#INTELXTRACT_API_KEYS__GITHUB=

# --- Optional AI assistant (Phase 23) ----------------------------------------
# Disabled by default. While on, report content is sent to the configured
# endpoint — nothing leaves this machine until you enable it and set a key.
# Point INTELXTRACT_ASSISTANT__BASE_URL at any OpenAI-compatible endpoint.
#INTELXTRACT_ASSISTANT__ENABLED=false
#INTELXTRACT_ASSISTANT__PROVIDER=openai
#INTELXTRACT_ASSISTANT__BASE_URL=https://api.openai.com/v1
#INTELXTRACT_ASSISTANT__MODEL=gpt-4o-mini
#INTELXTRACT_ASSISTANT__API_KEY=
#INTELXTRACT_ASSISTANT__TIMEOUT=60
#INTELXTRACT_ASSISTANT__MAX_TOKENS=800
#INTELXTRACT_ASSISTANT__TEMPERATURE=0

# --- Encrypted API-key vault (Phase 24) --------------------------------------
# `intelxtract key set <provider>` encrypts a key with Fernet and stores the
# ciphertext in the database (never in settings.json). The Fernet key is
# resolved from, in order: this variable, the OS keyring (if the optional
# `keyring` package is installed), then a 0600 key file. Set this only if you
# want an explicit, portable key (generate one with `python -c "from
# cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`).
#INTELXTRACT_VAULT__KEY_PATH=~/.local/share/intelxtract/vault.key
#INTELXTRACT_VAULT_KEY=

# --- Network settings (Phase 24) ---------------------------------------------
# Proxy and client-side rate limiting for all outbound HTTP requests.
#INTELXTRACT_NETWORK__PROXY=
#INTELXTRACT_NETWORK__RATE_LIMIT=0
#INTELXTRACT_NETWORK__TIMEOUT=30
#INTELXTRACT_NETWORK__RETRIES=2

# --- Performance tuning (Phase 25) -------------------------------------------
# Connection-pool and concurrency limits (0 disables a cap), per-host pacing,
# exponential-backoff bounds, and conditional-request (ETag) caching.
#INTELXTRACT_NETWORK__POOL_LIMIT=100
#INTELXTRACT_NETWORK__POOL_LIMIT_PER_HOST=8
#INTELXTRACT_NETWORK__MAX_CONCURRENCY=16
#INTELXTRACT_NETWORK__MAX_PER_HOST=4
#INTELXTRACT_NETWORK__RATE_LIMIT_PER_HOST=0
#INTELXTRACT_NETWORK__BACKOFF_BASE=0.5
#INTELXTRACT_NETWORK__BACKOFF_MAX=30
#INTELXTRACT_NETWORK__HTTP_CACHE=true
#INTELXTRACT_PERFORMANCE__OFFLOAD_WORKERS=4

# --- GUI / app settings (Phase 24) -------------------------------------------
# Theme is dark-only for now; language is en. Telemetry is always off.
#INTELXTRACT_GUI__THEME=dark
#INTELXTRACT_GUI__LANGUAGE=en
#INTELXTRACT_APP__TELEMETRY=false
