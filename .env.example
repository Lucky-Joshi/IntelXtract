# IntelXtract environment configuration.
#
# Copy this file to `.env` (git-ignored) and fill in your own values:
#
#     cp .env.example .env
#
# IntelXtract loads `.env` on startup; values never override environment
# variables that are already set, so exporting a variable wins over this file.
#
# Values map to config keys. Nested keys use `__` (double underscore) as the
# separator and names are lower-cased, so:
#
#     INTELXTRACT_API_KEYS__HIBP  ->  config api_keys.hibp
#
# Every key below is optional: a module or plugin that needs a missing key is
# skipped (or falls back to a key-free path) instead of failing the scan.

# --- External API keys (used by bundled modules/plugins) ---------------------

# HIBP — email breach exposure (modules/email/breach.py). Required to run the
# breach module; without it that module is skipped.
# Get a key: https://haveibeenpwned.com/API/Key
INTELXTRACT_API_KEYS__HIBP=

# AbuseIPDB — optional IP reputation enrichment (modules/ip/reputation.py).
# Reputation still works via key-free Spamhaus ZEN and DNSBL when unset.
# Get a key: https://www.abuseipdb.com/api
INTELXTRACT_API_KEYS__ABUSEIPDB=

# VirusTotal — domain report plugin (plugins/VirusTotal). Required to run that
# plugin; without it the plugin is skipped.
# Get a key: https://docs.virustotal.com/reference/overview
INTELXTRACT_API_KEYS__VIRUSTOTAL=

# --- Reserved providers (listed in the GUI API Manager) ----------------------
# No bundled module consumes these yet; uncomment and fill in when a plugin or
# future module needs them.
#INTELXTRACT_API_KEYS__SHODAN=
#INTELXTRACT_API_KEYS__CENSYS=
#INTELXTRACT_API_KEYS__SECURITYTRAILS=
#INTELXTRACT_API_KEYS__EMAILREP=
#INTELXTRACT_API_KEYS__HUNTER=
#INTELXTRACT_API_KEYS__GITHUB=
