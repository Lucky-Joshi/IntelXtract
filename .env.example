# Copy this file to `.env` (git-ignored) and fill in your own values.
# IntelXtract loads `.env` on startup; values never override already-set
# environment variables.

# Values map to config keys. Nested keys use `__` as the separator:
#   INTELXTRACT_API__KEYS__HIBP  ->  config api_keys.hibp
INTELXTRACT_API__KEYS__HIBP=