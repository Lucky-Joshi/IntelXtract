# Use SPEC_DIR (set by PyInstaller) or derive from current working directory.
SPEC_DIR = Path(os.path.dirname(os.path.abspath(__file__))) if '__file__' in dir() else Path.cwd()
ROOT = SPEC_DIR.parents[2] if SPEC_DIR.name == 'pyinstaller' else Path.cwd()
ASSETS = ROOT / "assets"
TEMPLATES = ROOT / "templates"

